# Shared secrets
JWT_SECRET=<your_jwt_secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
INTERNAL_API_KEY=<your_internal_api_key>

# Production environment for node 1. Ansible copies this file to /opt/btl/.env.
HOSTNAME=btl-app-vm-1
HOST_IP=<your_vm_ip>
ENVIRONMENT=prod
LOG_TYPE=btl
PROD_BIND_ADDRESS=127.0.0.1

# Central Logstash VM IP. Keep this same on both BTL VMs.
LOGSTASH_HOST=<your_elk_vm_ip>:5044

LOG_LEVEL=INFO
LOG_BACKUP_DAYS=7

TZ=Asia/Ho_Chi_Minh

CORS_ORIGINS=https://<your_domain>,https://www.<your_domain>,http://front-end:5173
PUBLIC_BASE_URL=https://<your_domain>

# MongoDB
MONGO_URI=mongodb://<mongo_username>:<mongo_password>@<mongo_host>:27017/bdc?authSource=admin&replicaSet=<your_replica_set>
MONGO_IMPORT_URI=mongodb://<mongo_username>:<mongo_password>@<mongo_host>:27017/bdc?directConnection=true&authSource=admin
MONGO_SEED_URI=mongodb://<mongo_username>:<mongo_password>@<mongo_host>:27017/bdc?directConnection=true&authSource=admin
MONGO_INITDB_ROOT_USERNAME=<mongo_username>
MONGO_INITDB_ROOT_PASSWORD=<mongo_password>
MONGO_EXPRESS_USERNAME=<mongo_express_username>
MONGO_EXPRESS_PASSWORD=<mongo_express_password>

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
PRODUCT_SERVICE_URL=http://product-service:8003
ORDER_SERVICE_URL=http://order-service:8004
SHOP_SERVICE_URL=http://shop-service:8005
PAYMENT_SERVICE_URL=http://payment-service:8006
CHAT_SERVICE_URL=http://chat-service:8010
UPLOAD_SERVICE_URL=http://upload-service:8011
COMPLAINT_SERVICE_URL=http://complaint-service:8012

# Service databases
AUTH_MONGO_DATABASE=auth_db
USER_MONGO_DATABASE=auth_db
PRODUCT_MONGO_DATABASE=product_db
ORDER_MONGO_DATABASE=order_db
SHOP_MONGO_DATABASE=shop_db
PAYMENT_MONGO_DATABASE=payment_db
CHAT_MONGO_DATABASE=chat_db
CHATBOT_MONGO_DATABASE=bdc
UPLOAD_MONGO_DATABASE=upload_db

# Google OAuth2
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>

# Google Cloud Storage
GCS_BUCKET_NAME=<your_gcs_bucket_name>
GCS_PROJECT_ID=<your_gcp_project_id>
GCS_CREDENTIALS_FILE=./secrets/gcs-key.json

# VNPay
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=<your_vnpay_tmn_code>
VNPAY_SECRET_KEY=<your_vnpay_secret_key>
VNPAY_RETURN_URL=https://<your_domain>/payment_return

# Frontend
VITE_MAX_IMAGE_SIZE=1048576
VITE_BASE_API_URL=/api
VITE_UPLOAD_API_URL=/api/v1/upload
VITE_BASE_BE_URL=https://<your_domain>
VITE_BASE_FE_URL=https://<your_domain>
FRONTEND_BASE_URL=https://<your_domain>
BACKEND_BASE_URL=http://gateway:8000
