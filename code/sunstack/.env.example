# Shared secrets
JWT_SECRET=JWT_SECRET=change_me
INTERNAL_API_KEY=change_me_internal_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- ELK / Filebeat -> Logstash ----
# Same BTL folder/compose can run on both BTL VMs.
# Change only HOSTNAME and HOST_IP per BTL VM:
#   app-vm-1 -> HOSTNAME=app-vm-1, HOST_IP=<ip-app-vm-1>
#   app-vm-2 -> HOSTNAME=app-vm-2, HOST_IP=<ip-app-vm-2>
HOSTNAME=app-vm-1
HOST_IP=<ip-this-btl-vm>
ENVIRONMENT=prod
LOG_TYPE=btl
LOGSTASH_HOST=<elk-vm-ip>:5044

LOG_LEVEL=INFO
LOG_BACKUP_DAYS=7

TZ=Asia/Ho_Chi_Minh

CORS_ORIGINS=http://localhost:5173,http://front-end:5173


AUTH_MONGO_DATABASE=auth_db
USER_MONGO_DATABASE=auth_db
PRODUCT_MONGO_DATABASE=product_db
ORDER_MONGO_DATABASE=order_db
SHOP_MONGO_DATABASE=shop_db
PAYMENT_MONGO_DATABASE=payment_db
CHAT_MONGO_DATABASE=chat_db
UPLOAD_MONGO_DATABASE=upload_db

AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
PRODUCT_SERVICE_URL=http://product-service:8003
ORDER_SERVICE_URL=http://order-service:8004
SHOP_SERVICE_URL=http://shop-service:8005
PAYMENT_SERVICE_URL=http://payment-service:8006
CHAT_SERVICE_URL=http://chat-service:8010
UPLOAD_SERVICE_URL=http://upload-service:8011

GCS_BUCKET_NAME=<bucket-name>
GCS_PROJECT_ID=<project-id>
GCS_CREDENTIALS_FILE=./secrets/gcs-key.json

GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>


MAIL_USERNAME=<username>@gmail.com
MAIL_PASSWORD=<password>

# VNPay
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=<tmn-code>
VNPAY_SECRET_KEY=<secret-key>
VNPAY_RETURN_URL=http://localhost:5173/payment_return

VITE_BASE_API_URL=http://localhost:8000/api
VITE_UPLOAD_API_URL=http://localhost:8000/api/v1/upload
VITE_BASE_BE_URL=http://localhost:8000
VITE_BASE_FE_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://gateway:8000